{
  "name": "pico",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pico",
    "after-school-care",
    "agent-extension"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:voice-providers": "jiti scripts/smoke/voice-providers.ts",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "ast": "ast-grep scan --config sgconfig.yml src tests",
    "ast:test": "ast-grep test --config sgconfig.yml --skip-snapshot-tests",
    "check": "npm run typecheck && npm run lint && npm run ast:test && npm run ast && npm run format:check && npm run test",
    "check:ci": "bash scripts/ci/run-quality-gates.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.43.0",
    "@biomejs/biome": "^2.4.16",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "jiti": "^2.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
