{
  "name": "pico",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pico",
    "after-school-care",
    "agent-extension"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:milestone": "jiti scripts/smoke/milestone-suite.ts",
    "smoke:camera-vlm-scene": "jiti scripts/smoke/camera-vlm-scene.ts",
    "smoke:person-detection": "jiti scripts/smoke/person-detection.ts",
    "smoke:mem0-runtime": "jiti scripts/smoke/mem0-runtime.ts",
    "smoke:embedding-sidecar": "jiti scripts/smoke/embedding-sidecar.ts",
    "smoke:ollama-vlm": "jiti scripts/smoke/ollama-vlm-connectivity.ts",
    "smoke:camera-tapo": "jiti scripts/smoke/tapo-rtsp-snapshot.ts",
    "smoke:camera-ptz": "jiti scripts/smoke/tapo-person-follow-nudge.ts",
    "smoke:person-follow-runtime": "jiti scripts/smoke/person-follow-runtime.ts",
    "smoke:voice-providers": "jiti scripts/smoke/voice-providers.ts",
    "smoke:resident-audio-input": "jiti scripts/smoke/resident-audio-input.ts",
    "smoke:pi-runtime": "jiti scripts/smoke/pi-runtime.ts",
    "field:session-memory-lifecycle": "jiti scripts/field/session-memory-lifecycle.ts",
    "field:person-follow-visible-person": "jiti scripts/field/person-follow-visible-person.ts",
    "field:voice-echo-pickup": "jiti scripts/field/voice-echo-pickup.ts",
    "resident:voice:dev-terminal": "jiti scripts/resident/development-terminal.ts",
    "resident:memory": "jiti scripts/resident/memory.ts",
    "resident:voice:launchd": "jiti scripts/resident/launchd.ts",
    "resident:voice": "jiti scripts/resident/voice.ts",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "ast": "ast-grep scan --config sgconfig.yml src tests",
    "ast:test": "ast-grep test --config sgconfig.yml --skip-snapshot-tests",
    "check": "npm run typecheck && npm run lint && npm run ast:test && npm run ast && npm run format:check && npm run test",
    "check:ci": "bash scripts/ci/run-quality-gates.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.43.0",
    "@biomejs/biome": "^2.4.16",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "jiti": "^2.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@qdrant/js-client-rest": "^1.18.0",
    "better-sqlite3": "^12.10.0",
    "mem0ai": "^3.0.7",
    "ollama": "^0.5.18",
    "onnxruntime-node": "^1.26.0",
    "onvif": "^0.8.1",
    "sharp": "^0.35.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
