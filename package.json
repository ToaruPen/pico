{
  "name": "pico",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pico",
    "after-school-care",
    "agent-extension"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pico": "./bin/pico"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:milestone": "jiti scripts/smoke/milestone-suite.ts",
    "smoke:otel-telemetry": "jiti scripts/smoke/otel-telemetry.ts",
    "smoke:camera-vlm-scene": "jiti scripts/smoke/camera-vlm-scene.ts",
    "smoke:person-detection": "jiti scripts/smoke/person-detection.ts",
    "smoke:ollama-vlm": "jiti scripts/smoke/ollama-vlm-connectivity.ts",
    "smoke:camera-tapo": "jiti scripts/smoke/tapo-rtsp-snapshot.ts",
    "smoke:camera-ptz": "jiti scripts/smoke/tapo-person-follow-nudge.ts",
    "smoke:person-follow-runtime": "jiti scripts/smoke/person-follow-runtime.ts",
    "smoke:voice-providers": "jiti scripts/smoke/voice-providers.ts",
    "smoke:resident-audio-input": "jiti scripts/smoke/resident-audio-input.ts",
    "smoke:pi-runtime": "jiti scripts/smoke/pi-runtime.ts",
    "field:person-follow-visible-person": "jiti scripts/field/person-follow-visible-person.ts",
    "field:stackchan-camera-grid": "jiti scripts/field/stackchan-camera-grid.ts",
    "field:stackchan-center-calibration": "jiti scripts/field/stackchan-center-calibration.ts",
    "field:stackchan-face-follow": "jiti scripts/field/stackchan-face-follow.ts",
    "field:stackchan-head-target-lane": "jiti scripts/field/stackchan-head-target-lane.ts",
    "field:stackchan-motion-continuity": "jiti scripts/field/stackchan-motion-continuity.ts",
    "field:stackchan-attention-replay": "jiti scripts/field/stackchan-attention-replay.ts",
    "field:stackchan-attention-replay-evidence": "jiti scripts/field/stackchan-attention-replay-evidence.ts",
    "field:stackchan-target-filter-evaluation": "jiti scripts/field/stackchan-target-filter-evaluation.ts",
    "field:resident-pi-turn-measure": "jiti scripts/field/resident-pi-turn-measure.ts",
    "field:resident-hold-to-talk": "jiti scripts/field/resident-hold-to-talk.ts",
    "field:resident-voice-pseudo-audio": "jiti scripts/field/resident-voice-pseudo-audio.ts",
    "resident:voice:dev-terminal": "jiti scripts/resident/development-terminal.ts",
    "resident:voice:metrics": "jiti scripts/resident/voice-measure.ts",
    "resident:voice:launchd": "jiti scripts/resident/launchd.ts",
    "resident:voice": "jiti scripts/resident/voice.ts",
    "pico": "jiti scripts/pico.ts",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "ast": "ast-grep scan --config sgconfig.yml src tests",
    "ast:test": "ast-grep test --config sgconfig.yml --skip-snapshot-tests",
    "check": "npm run typecheck && npm run lint && npm run ast:test && npm run ast && npm run format:check && npm run test",
    "check:ci": "bash scripts/ci/run-quality-gates.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.43.0",
    "@biomejs/biome": "^2.4.16",
    "@earendil-works/pi-tui": "^0.80.6",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "jiti": "^2.6.1",
    "secretlint": "13.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "exceljs": "4.4.0",
    "ollama": "^0.5.18",
    "onnxruntime-node": "^1.26.0",
    "onvif": "^0.8.1",
    "sharp": "^0.35.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
